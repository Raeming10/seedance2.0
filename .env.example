# Required for Flare, Seedance and MiniMax. Never commit actual keys.
FAL_KEY=
# Optional: required only for the official Google Veo provider.
GOOGLE_GENERATIVE_AI_API_KEY=
PORT=8000
HOST=127.0.0.1
# Shared server only: use a strong random token, HTTPS reverse proxy and persistent disk.
# On a teammate's local client, set STUDIO_URL to the shared Studio address.
# STUDIO_URL=https://studio.example.com
# STUDIO_API_TOKEN=
# COOKIE_SECURE=true
# STUDIO_DATA_DIR=/data/studio
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# The Codex plugin sets STUDIO_ENV_FILE to a private config outside its cache.
