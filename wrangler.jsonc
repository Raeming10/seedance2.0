{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seedance-internal-tool",
  "main": "src/app-worker.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "seedance-internal-media"
    }
  ],
  "vars": {
    "MEDIA_BASE_URL": "https://seedance-internal-media.invalid"
  },
  "secrets": {
    "required": [
      "BYTEPLUS_API_KEY",
      "FAL_KEY",
      "INTERVIEWCODER_API_KEY",
      "MEDIA_SIGNING_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
